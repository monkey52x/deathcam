{
  "schemaVersion": 1,
  "id": "${mod_id}",
  "version": "${version}",
  "name": "${mod_name}",
  "description": "${description}",
  "authors": ["${mod_author}"],
  "license": "${license}",
  "entrypoints": {
    "client": ["com.vlogf.deathcamera.fabric.DeathCameraFabric"],
    "modmenu": ["com.vlogf.deathcamera.fabric.DeathCameraModMenu"]
  },
  "mixins": ["${mod_id}.mixins.json"],
  "depends": {
    "fabricloader": ">=${fabric_loader_version}",
    "fabric-api": "*",
    "minecraft": "~${minecraft_version}",
    "java": ">=${java_version}"
  },
  "suggests": {
    "cloth-config": "*",
    "modmenu": "*"
  }
}
